{
  "name": "foxwatch",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@11.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "node scripts/deploy.mjs",
    "types": "wrangler types",
    "test": "vitest run",
    "check-types": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.worker.json",
    "preinstall": "node -e \"const a=process.env.npm_config_user_agent||''; if(!a.includes('pnpm')){console.error('Foxwatch uses pnpm workspaces. Install pnpm: https://pnpm.io/installation'); process.exit(1)}\"",
    "foxwatch": "node scripts/cli.mjs"
  },
  "cloudflare": {
    "bindings": {
      "DB": {
        "description": "D1 for checks, incidents, and operator accounts. Keep the name `foxwatch-data`."
      },
      "STATUS": {
        "description": "KV for the public status snapshot. On the Deploy to Cloudflare setup page, name it `foxwatch-status`."
      },
      "ALERTS": {
        "description": "Queue for Slack, Discord, and webhook alerts (`foxwatch-alerts`)."
      }
    }
  },
  "dependencies": {
    "@foxwatch/config": "workspace:*",
    "@foxwatch/engine": "workspace:*",
    "drizzle-orm": "^0.44.5",
    "heic-to": "^1.5.2",
    "hono": "^4.9.8",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "vgpu": "^0.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.13.0",
    "@cloudflare/workers-types": "5.20260816.1",
    "@tailwindcss/vite": "^4.1.13",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vgpu/wgsl": "^0.3.0",
    "@vitejs/plugin-react": "^5.0.2",
    "@webgpu/types": "^0.1.71",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^3.2.4",
    "wrangler": "^4.34.0"
  }
}
